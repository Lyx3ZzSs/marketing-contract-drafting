# Local development only. Compose uses its internal postgres/redis hostnames.
DATABASE_URL=postgresql+psycopg://contract:contract_dev@127.0.0.1:15432/contract_drafting
REDIS_URL=redis://127.0.0.1:16379/0
APP_ENV=development
LOG_LEVEL=INFO
SSE_POLL_SECONDS=0.5
SSE_HEARTBEAT_SECONDS=10

# Full-contract PDF preview. Compose shares a persistent local volume by default.
# Set s3 only when the existing company MinIO test bucket is configured.
PREVIEW_STORAGE=local
PREVIEW_TTL_HOURS=24
PREVIEW_TIMEOUT_SECONDS=120
PREVIEW_RENDERER_REVISION=libreoffice-noto-cjk-v1
# Native development: API, worker and scheduler must use the same absolute directory.
PREVIEW_DIRECTORY=/tmp/contract-previews
LIBREOFFICE_BINARY=soffice

# Existing company MinIO. Use a dedicated, already-created TEST bucket.
# Endpoint is hostname[:port], without http:// or https://.
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_USE_TLS=true
S3_VERIFY_TLS=true

# No real CRM/model calls are implemented in this scaffold.
CRM_MODE=demo
LLM_ENABLED=false

# OA MySQL: independent read-only connection. Never expose credentials to the frontend.
OA_HOST=
OA_PORT=3306
OA_DATABASE=
OA_USER=
OA_PASSWORD=
OA_CONNECT_TIMEOUT=3
OA_QUERY_TIMEOUT=5

# 统一认证；前端只读取 /api/v1/auth/config 中的公开参数，不配置 Client Secret
OIDC_ISSUER=http://10.8.6.32:18080/realms/company-dev
# Bounded clock tolerance for JWT iat/nbf/exp; keep issuer/API clocks synchronized.
OIDC_CLOCK_SKEW_SECONDS=5
OIDC_AUDIENCE=marketing-contract-drafting-api
OIDC_WEB_CLIENT_ID=marketing-contract-drafting-web
OIDC_FRONTEND_URL=http://127.0.0.1:15173
